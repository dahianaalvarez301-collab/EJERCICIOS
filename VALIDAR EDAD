	tarifaBase = 45000
	descuento = 0
	recargo = 0
	
	Si edad < 12 O edad >= 65 Entonces
descuento = tarifaBase * 0.20
	FinSi
	
	Si imc >= 30.0 Entonces
recargo = 12000
	FinSi
	
	total = (tarifaBase - descuento) + recargo
FinFuncion

SubProceso RegistrarPaciente(edad, imc, recaudo Por Referencia, vulnerables Por Referencia, riesgo_imc Por Referencia)
	Definir aPagar Como Real
	aPagar <- CalcularTarifa(edad, imc)
	recaudo <- recaudo + aPagar
	
	Si edad < 12 O edad >= 65 Entonces
vulnerables = vulnerables + 1
	FinSi
	
	Si imc >= 30.0 Entonces
riesgo_imc = riesgo_imc + 1
	FinSi
	
	Escribir "Total a pagar: $", aPagar
FinSubProceso

